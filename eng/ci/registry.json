{
  "schema_version": 1,
  "targets": {
    "product": {
      "setup": [
        {
          "label": "Restore .NET solution",
          "argv": ["dotnet", "restore", "Genkidama.slnx"]
        }
      ],
      "validation": [
        {
          "label": "Build .NET solution",
          "argv": ["dotnet", "build", "Genkidama.slnx", "--configuration", "Release", "--no-restore"]
        },
        {
          "label": "Test .NET solution",
          "argv": ["dotnet", "test", "Genkidama.slnx", "--configuration", "Release", "--no-build", "--collect:XPlat Code Coverage", "--logger", "trx", "--results-directory", "TestResults"]
        },
        {
          "label": "Pack Genkidama CLI",
          "argv": ["dotnet", "pack", "src/Genkidama.Cli/Genkidama.Cli.csproj", "--configuration", "Release", "--no-build", "--output", "artifacts/packages"]
        }
      ]
    },
    "quality": {
      "setup": [
        {
          "label": "Install Learn validator dependency",
          "argv": ["{python}", "-m", "pip", "install", "--disable-pip-version-check", "-r", "learn/_meta/requirements.txt"]
        }
      ],
      "validation": [
        {
          "label": "Compile local CI Python",
          "argv": ["{python}", "-m", "compileall", "-q", "eng/ci"]
        },
        {
          "label": "Test local CI engine",
          "argv": ["{python}", "-m", "unittest", "discover", "-s", "eng/ci/tests", "-p", "test_*.py"]
        },
        {
          "label": "Validate Learn foundation",
          "argv": ["{python}", "learn/_meta/validate.py"]
        }
      ]
    },
    "learn-dotnet": {
      "setup": [
        {
          "label": "Inspect .NET toolchain",
          "argv": ["dotnet", "--version"]
        }
      ],
      "validation": [
        {
          "label": "Validate .NET Learn contracts for current platform",
          "argv": ["{python}", "eng/ci/adapters/learn_dotnet.py"]
        }
      ]
    },
    "patterns-dotnet": {
      "setup": [
        {
          "label": "Inspect .NET toolchain",
          "argv": ["dotnet", "--version"]
        }
      ],
      "validation": [
        {
          "label": "Validate .NET pattern family",
          "argv": ["{python}", "eng/ci/adapters/dotnet_patterns.py"]
        }
      ]
    },
    "learn-jvm": {
      "setup": [
        {
          "label": "Inspect Java runtime",
          "argv": ["java", "--version"]
        }
      ],
      "validation": [
        {
          "label": "Validate JVM Learn profile",
          "argv": ["{python}", "eng/ci/adapters/learn_jvm.py"]
        }
      ]
    },
    "patterns-jvm": {
      "setup": [
        {
          "label": "Inspect Java runtime",
          "argv": ["java", "--version"]
        }
      ],
      "validation": [
        {
          "label": "Validate JVM pattern profile",
          "argv": ["{python}", "eng/ci/adapters/jvm_patterns.py"]
        }
      ]
    },
    "learn-native": {
      "setup": [],
      "validation": [
        {
          "label": "Validate Native Learn profile",
          "argv": ["{python}", "eng/ci/adapters/learn_native.py"]
        }
      ]
    },
    "patterns-native": {
      "setup": [],
      "validation": [
        {
          "label": "Validate Native pattern profile",
          "argv": ["{python}", "eng/ci/adapters/native_patterns.py"]
        }
      ]
    },
    "patterns-beam": {
      "setup": [],
      "validation": [
        {
          "label": "Validate BEAM pattern family",
          "argv": ["{python}", "eng/ci/adapters/beam_patterns.py"]
        }
      ]
    },
    "patterns-prototype-dotnet": {
      "setup": [
        {
          "label": "Inspect .NET toolchain",
          "argv": ["dotnet", "--version"]
        }
      ],
      "validation": [
        {
          "label": "Validate C# Prototype contract",
          "argv": ["{python}", "eng/ci/adapters/prototype.py", "dotnet"]
        }
      ]
    },
    "patterns-prototype-jvm": {
      "setup": [
        {
          "label": "Inspect Java toolchain",
          "argv": ["java", "-version"]
        },
        {
          "label": "Inspect javac toolchain",
          "argv": ["javac", "-version"]
        }
      ],
      "validation": [
        {
          "label": "Validate Java Prototype contract",
          "argv": ["{python}", "eng/ci/adapters/prototype.py", "jvm"]
        }
      ]
    },
    "patterns-prototype-native": {
      "setup": [
        {
          "label": "Inspect Rust toolchain",
          "argv": ["rustc", "--version"]
        }
      ],
      "validation": [
        {
          "label": "Validate Rust Prototype contract",
          "argv": ["{python}", "eng/ci/adapters/prototype.py", "native"]
        }
      ]
    },
    "patterns-platform-source": {
      "setup": [],
      "validation": [
        {
          "label": "Validate VBA and Delphi source contracts",
          "argv": ["{python}", "eng/ci/adapters/platform_source_contracts.py"]
        }
      ]
    },
    "patterns-portable-functional-507": {
      "setup": [
        {
          "label": "Inspect Docker engine",
          "argv": ["docker", "version"]
        }
      ],
      "validation": [
        {
          "label": "Validate 507 portable-functional pattern cells",
          "argv": ["bash", "scripts/validate-portable-functional-cohort.sh"]
        }
      ]
    }
  },
  "families": {
    "beam": {
      "patterns": "patterns-beam"
    },
    "dotnet": {
      "learn": "learn-dotnet",
      "patterns": "patterns-dotnet"
    },
    "jvm": {
      "learn": "learn-jvm",
      "patterns": "patterns-jvm"
    },
    "native": {
      "learn": "learn-native",
      "patterns": "patterns-native"
    },
    "platform": {
      "patterns": "patterns-platform-source"
    },
    "portable-functional": {
      "patterns": "patterns-portable-functional-507"
    }
  },
  "change_detection": {
    "full_paths": [
      "eng/ci/",
      ".github/workflows/polyglot.yml"
    ],
    "product_paths": [
      "Genkidama.slnx",
      "src/Genkidama.Access/",
      "src/Genkidama.Application/",
      "src/Genkidama.Blueprints/",
      "src/Genkidama.Cli/",
      "src/Genkidama.Contracts/",
      "src/Genkidama.Data/",
      "src/Genkidama.Events/",
      "src/Genkidama.Http/",
      "src/Genkidama.Jobs/",
      "clients/",
      "tests/"
    ],
    "quality_paths": [
      "README.md",
      "learn/_meta/"
    ],
    "learn_root": "learn/es/",
    "family_paths": {
      "beam": [
        "src/Functional/Elixir/patterns/",
        "src/Functional/Erlang/patterns/"
      ],
      "dotnet": [
        "learn/es/csharp/",
        "learn/es/fsharp/",
        "learn/es/vbnet/",
        "src/Enterprise/C#/",
        "src/Functional/F#/",
        "src/Enterprise/VisualBasic/"
      ],
      "jvm": [
        "learn/es/java/",
        "learn/es/kotlin/",
        "src/Enterprise/Java/",
        "src/Enterprise/Kotlin/",
        "src/Functional/Groovy/"
      ],
      "native": [
        "learn/es/c/",
        "learn/es/cpp/",
        "learn/es/rust/",
        "learn/es/go/",
        "src/Systems/C/patterns/",
        "src/Systems/C++/patterns/",
        "src/Systems/Rust/patterns/",
        "src/Systems/Rust/prototype.rs",
        "src/Systems/Go/pattern_sweep.go"
      ],
      "platform": [
        "src/Shell/VBA/example1.bas",
        "src/Enterprise/Delphi/Example1.pas"
      ],
      "portable-functional": [
        "scripts/validate-portable-functional-cohort.sh",
        "src/Systems/Rust/patterns/",
        "src/Systems/C/patterns/",
        "src/Systems/C++/patterns/",
        "src/Enterprise/Java/patterns/",
        "src/Functional/Groovy/patterns/",
        "src/Functional/OCaml/patterns/",
        "src/Functional/CommonLisp/patterns/",
        "src/Functional/Prolog/patterns/",
        "src/DataScience/R/patterns/",
        "src/DataScience/Octave/patterns/",
        "src/Scripting/PowerShell/patterns/"
      ]
    }
  }
}
