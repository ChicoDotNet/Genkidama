ENTERPRISE-BRIDGE-PATTERN.
    MOVE "kafka" TO TEXT-A
    MOVE "ALERT" TO TEXT-B
    MOVE "disk" TO TEXT-C
    MOVE SPACES TO TEXT-D
    STRING TEXT-A(1:5) DELIMITED BY SIZE ">" DELIMITED BY SIZE
           TEXT-B(1:5) DELIMITED BY SIZE ":" DELIMITED BY SIZE
           TEXT-C(1:4) DELIMITED BY SIZE INTO TEXT-D END-STRING
    IF TEXT-D(1:16) NOT = "kafka>ALERT:disk" PERFORM FAIL END-IF
    MOVE "queue" TO TEXT-A MOVE "REMINDER" TO TEXT-B MOVE "backup" TO TEXT-C MOVE SPACES TO TEXT-D
    STRING TEXT-A(1:5) DELIMITED BY SIZE ">" DELIMITED BY SIZE
           TEXT-B(1:8) DELIMITED BY SIZE ":" DELIMITED BY SIZE
           TEXT-C(1:6) DELIMITED BY SIZE INTO TEXT-D END-STRING
    IF TEXT-D(1:21) = "queue>REMINDER:backup" PERFORM PASS ELSE PERFORM FAIL END-IF.
